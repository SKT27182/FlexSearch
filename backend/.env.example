# =============================================================================
# FlexSearch Backend Environment
# =============================================================================

# -----------------------------------------------------------------------------
# App / Deploy
# -----------------------------------------------------------------------------
API_PORT=8889
APP_PUBLIC_URL=https://flexsearch.skt27182.com
APP_PUBLIC_HOST=flexsearch.skt27182.com
SERVICE_PUBLIC_HOST=flexsearch.skt27182.com
CORS_ORIGINS=http://localhost:5144,http://127.0.0.1:5144
DEBUG=true
LOG_LEVEL=INFO
# Opt-in SQL statement logging through the colored app logger (also on when LOG_LEVEL=DEBUG)
SQL_ECHO=false
LOG_PATH=./logs

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flexsearch
POSTGRES_USER=flexsearch
POSTGRES_PASSWORD=flexsearch_secret
# Optional override for full connection string:
POSTGRES_URL=postgresql+asyncpg://flexsearch:flexsearch_secret@localhost:5432/flexsearch

# infra-hub main_db (read-only; used to authenticate INFRA_ADMIN users)
# Must match infra-hub Postgres credentials (see infra-hub backend/.env).
INFRA_HUB_POSTGRES_DB=main_db
# Optional override (defaults to POSTGRES_URL credentials with main_db):
# INFRA_HUB_POSTGRES_URL=postgresql://admin:password@127.0.0.1:54321/main_db

# Service metadata
POSTGRES_SERVICE_NAME=postgres
POSTGRES_DISPLAY_NAME=PostgreSQL
POSTGRES_CONTAINER_NAME=infra-postgres

# -----------------------------------------------------------------------------
# OpenSearch (vector + BM25 + hybrid; consume infra-hub as-is)
# Connection matrix:
#   Containers on infra-network: http://opensearch:9200
#   Host / local:                http://127.0.0.1:9200
# Smoke-check: curl -s http://127.0.0.1:9200 | head
# -----------------------------------------------------------------------------
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX_PREFIX=flexsearch
OPENSEARCH_INDEX_NAME=chunks
# Optional future auth/TLS (hub security is currently off):
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_KNN_M=16
OPENSEARCH_KNN_EF_CONSTRUCTION=100
OPENSEARCH_KNN_EF_SEARCH=100

# Service metadata
OPENSEARCH_SERVICE_NAME=opensearch
OPENSEARCH_DISPLAY_NAME=OpenSearch
OPENSEARCH_CONTAINER_NAME=infra-opensearch

# -----------------------------------------------------------------------------
# MinIO (S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=flexsearch
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Service metadata
MINIO_SERVICE_NAME=minio
MINIO_DISPLAY_NAME=MinIO
MINIO_CONTAINER_NAME=infra-minio

# -----------------------------------------------------------------------------
# Redis (SSE progress + Celery broker; copy password from infra-hub/backend/.env)
# Connection matrix:
#   Containers on infra-network: redis://:${REDIS_PASSWORD}@redis:6379/0
#   Host / local:                redis://:${REDIS_PASSWORD}@127.0.0.1:63791/0
# Smoke-check: redis-cli -h 127.0.0.1 -p 63791 -a "$REDIS_PASSWORD" ping
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=63791
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
# Optional full URL override (if set, ignores REDIS_HOST/PORT/PASSWORD/DB):
# REDIS_URL=redis://:password@127.0.0.1:63791/0

# Celery (defaults to REDIS_URL as broker + result backend)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# Website crawler (Phase 4)
# -----------------------------------------------------------------------------
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=50
CRAWL_RATE_LIMIT=0.5
CRAWL_RESPECT_ROBOTS=true
CRAWL_USE_SITEMAP=true
# Reject private/loopback crawl & bulk URL targets (SSRF protection)
CRAWL_BLOCK_PRIVATE_URLS=true

# -----------------------------------------------------------------------------
# Rate limits (Phase 5 — sensitive APIs; 0 = unlimited for that rule)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_CRAWL_PER_MINUTE=10
RATE_LIMIT_BULK_PER_MINUTE=10
RATE_LIMIT_SENSITIVE_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Observability (Phase 5)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Neo4j (Graph RAG backend=neo4j; match infra-hub NEO4J_* credentials)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HTTP_PORT=7474

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# LLM (LiteLLM proxy or provider; required for VLM extraction + Graph RAG)
# -----------------------------------------------------------------------------
# Optional LiteLLM base URL / proxy (blank = provider default)
LLM_API_BASE=
MODEL_NAME=gpt-4o-mini
API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# Vector embedding (LiteLLM API, or local sentence-transformers when no key)
# -----------------------------------------------------------------------------
# Optional LiteLLM base URL for API embeddings (blank = provider default)
EMBEDDING_API_BASE=
# Local (sentence-transformers/...) OR a LiteLLM id (openai/text-embedding-3-small)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Blank => local HuggingFace embedding is used (no API call)
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# RAG strategies
# -----------------------------------------------------------------------------
EXTRACTION_STRATEGY=ocr
CHUNKING_STRATEGY=fixed_window
RETRIEVAL_STRATEGY=dense
RERANKING_STRATEGY=none

# -----------------------------------------------------------------------------
# Microsoft GraphRAG (Graph RAG backend=microsoft; LiteLLM API embedding ONLY)
# -----------------------------------------------------------------------------
GRAPH_INDEXING_ENABLED=true
GRAPHRAG_COMMUNITY_LEVEL=2
# Optional LiteLLM base URL for GraphRAG embeddings (falls back to EMBEDDING_API_BASE)
GRAPHRAG_EMBEDDING_API_BASE=
GRAPHRAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# Falls back to EMBEDDING_API_KEY then API_KEY
GRAPHRAG_EMBEDDING_API_KEY=
