# =============================================================================
# FlexSearch Celery Worker - Dockerfile
# =============================================================================
FROM python:3.11.13-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.19 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app

RUN addgroup --system flexsearch && adduser --system --ingroup flexsearch flexsearch \
    && mkdir -p /tmp/flexsearch && chown -R flexsearch:flexsearch /app /tmp/flexsearch

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER flexsearch

# Default: all Phase 0 queues (ingest/graph/summary/default)
ENV CELERY_QUEUES=ingest,graph,summary,default
ENV CELERY_CONCURRENCY=2

CMD ["sh", "-c", "celery -A app.celery_app worker --loglevel=INFO -Q ${CELERY_QUEUES} --concurrency=${CELERY_CONCURRENCY}"]
