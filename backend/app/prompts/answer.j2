<untrusted_context>
Context passages (cite with [n]):
{% for passage in passages %}
<passage citation="{{ loop.index }}">{{ passage | tojson }}</passage>
{% endfor %}
</untrusted_context>

{% if history %}
<untrusted_history>
Recent conversation:
{% for turn in history %}
{{ turn | tojson }}
{% endfor %}
</untrusted_history>
{% endif %}

User question: {{ question | tojson }}

Write a clear answer grounded in the context. Use [n] citations where claims come from passages.
